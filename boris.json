{
  "format": "boris-publication-profile",
  "schema_version": 1,
  "input": "content",
  "site": {
    "url": "https://drawmeanelephant.github.io/factory-docs-boris",
    "title": "Unofficial Boris Compiler Demo",
    "description": "Independent, unofficial historical documentation demo. Not affiliated with, endorsed by, or maintained by Factory, Factory AI, or the makers of Droid."
  },
  "publication": {
    "target": "github-pages",
    "base_url": "https://drawmeanelephant.github.io/factory-docs-boris",
    "origin": "https://drawmeanelephant.github.io",
    "base_path": "/factory-docs-boris"
  },
  "targets": [
    {
      "name": "public",
      "output": "dist",
      "public": true,
      "theme": "themes/factory",
      "layout_rules": [
        {
          "selector": "id:index",
          "layout": "themes/factory/layouts/trunk.html"
        },
        {
          "selector": "id:jp/index",
          "layout": "themes/factory/layouts/trunk.html"
        }
      ],
      "static": {
        "dir": "static"
      },
      "sitemap": {
        "path": "sitemap.xml"
      },
      "rss": {
        "path": "rss.xml",
        "limit": 20
      },
      "head": {
        "enabled": true,
        "base_url": "https://drawmeanelephant.github.io/factory-docs-boris",
        "ogp": "required",
        "defaults": {
          "description": "Unofficial independent Boris compiler demo. Not affiliated with Factory, Factory AI, or the makers of Droid. Historical content may be outdated; use docs.factory.ai for official information.",
          "image": {
            "source": "static",
            "path": "images/unofficial-demo-social.png",
            "alt": "Unofficial Boris compiler demo — not affiliated with Factory or Droid"
          },
          "twitter_card": "summary_large_image"
        }
      }
    }
  ]
}
